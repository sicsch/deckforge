# Provider-Auswahl: azure | openrouter
LLM_PROVIDER=azure

# Antworten streamen (Default: an). 0 = alte Einzelantwort, siehe app/README.md
LLM_STREAMING=1
# Timeout pro LLM-Aufruf in Sekunden (Default: 300)
LLM_TIMEOUT_SECONDS=300

# --- Azure OpenAI (Firmenumgebung, Auth via DefaultAzureCredential) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_AD_SCOPE=

# --- Alternativ-Provider (private Entwicklung) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
